#!/bin/sh
# Custom menu on the stick (GeneralPlus GPL32900B). Writes NOTHING to the flash.
# Starts our menu directly, WITHOUT the 10 in 1 (audio and screen stay ours alone).
# The menu does not depend on a controller: controllers can be turned on and off at any time.
# Opening a game: the menu writes launch.txt (runner, game, saves folder) and exits with code 10; this script
# runs the game and reopens the menu, which returns to the same place (menu-state.txt). This way the game has all the memory.
# Holding START for 3 s closes the menu (code 0) and this script starts the factory 10 in 1.
# Logs: log-steps.txt (this script) and log-stick.txt (menu, games and controllers).
R=/usr/retro
P=$R/log-steps.txt
step() { echo "$(cat /proc/uptime) $*" >> $P; sync; }

step "1 start, opening the menu without 10in1"
while true; do
    STICK_GAME_VIA_INIT=1 STICK_ROMS=$R/roms STICK_LOG=$R/log-stick.txt $R/menu-arm >> $R/log-menu.txt 2>&1
    rc=$?
    [ "$rc" = 10 ] || break
    {
        read -r prog
        read -r game
        read -r saves
    } < $R/launch.txt
    step "game: $game"
    STICK_ROMS=$R/roms STICK_LOG=$R/log-stick.txt "$prog" "$game" "$saves" >> $R/log-menu.txt 2>&1
    step "game exited (code $?)"
done
step "2 menu exited (code $rc), starting the 10in1"
/system/app/main &
